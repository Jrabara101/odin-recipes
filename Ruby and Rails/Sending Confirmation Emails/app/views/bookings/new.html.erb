<% content_for :title, "Passenger Information // AERO Flight Booker" %>

<div class="page-container">
  <!-- Booking Step Progress Indicator -->
  <div class="steps-progress-bar" aria-label="Booking steps">
    <div class="step-item completed" id="step-search">
      <div class="step-circle">✓</div>
      <div class="step-label">
        <span class="step-num">Step 1</span>
        <span class="step-title">Select Flight</span>
      </div>
    </div>
    <div class="step-connector completed"></div>
    <div class="step-item active" id="step-passengers">
      <div class="step-circle">2</div>
      <div class="step-label">
        <span class="step-num">Step 2</span>
        <span class="step-title">Passenger Details</span>
      </div>
    </div>
    <div class="step-connector"></div>
    <div class="step-item" id="step-confirm">
      <div class="step-circle">3</div>
      <div class="step-label">
        <span class="step-num">Step 3</span>
        <span class="step-title">Boarding Pass</span>
      </div>
    </div>
  </div>

  <div class="booking-flow-layout">
    <!-- Left Column: Flight Summary Card -->
    <aside class="booking-sidebar">
      <div class="summary-card">
        <div class="summary-card-header">
          <h3>Selected Flight Summary</h3>
          <span class="flight-badge"><%= @flight.flight_number %></span>
        </div>

        <div class="summary-route">
          <div class="route-city-block">
            <span class="route-code"><%= @flight.departure_airport.code %></span>
            <span class="route-city"><%= @flight.departure_airport.city %></span>
            <span class="route-time"><%= @flight.formatted_time %></span>
          </div>

          <div class="route-arrow">
            <span>✈</span>
            <span class="route-duration"><%= @flight.formatted_duration %></span>
          </div>

          <div class="route-city-block right">
            <span class="route-code"><%= @flight.arrival_airport.code %></span>
            <span class="route-city"><%= @flight.arrival_airport.city %></span>
            <span class="route-time"><%= @flight.formatted_arrival_time %></span>
          </div>
        </div>

        <div class="summary-details-list">
          <div class="summary-detail-row">
            <span class="detail-label">Departure Date</span>
            <span class="detail-value"><%= @flight.formatted_full_date %></span>
          </div>
          <div class="summary-detail-row">
            <span class="detail-label">Origin Airport</span>
            <span class="detail-value"><%= @flight.departure_airport.name %></span>
          </div>
          <div class="summary-detail-row">
            <span class="detail-label">Destination Airport</span>
            <span class="detail-value"><%= @flight.arrival_airport.name %></span>
          </div>
          <div class="summary-detail-row">
            <span class="detail-label">Ticket Count</span>
            <span class="detail-value"><%= pluralize(@num_tickets, "Passenger Ticket") %></span>
          </div>
        </div>

        <div class="summary-footer">
          <%= link_to "← Choose a Different Flight", root_path, class: "btn-link-back", id: "back-to-flights-link" %>
        </div>
      </div>
    </aside>

    <!-- Right Column: Passenger Information Form -->
    <section class="booking-form-section">
      <div class="form-header-card">
        <h2>Enter Passenger Information</h2>
        <p>Please enter full legal passenger names matching government-issued identification for all <strong><%= pluralize(@num_tickets, "passenger") %></strong>.</p>
      </div>

      <% if @booking.errors.any? %>
        <div class="error-explanation" id="error_explanation">
          <div class="error-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <h4><%= pluralize(@booking.errors.count, "error") %> prohibited this booking from being saved:</h4>
          </div>
          <ul class="error-list">
            <% @booking.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @booking, url: bookings_path, local: true, class: "booking-passengers-form", id: "booking_passengers_form" do |f| %>
        <%= f.hidden_field :flight_id, value: @flight.id %>

        <div class="passenger-cards-stack">
          <%= f.fields_for :passengers do |passenger_form| %>
            <div class="passenger-card" id="passenger_card_<%= passenger_form.index %>">
              <div class="passenger-card-header">
                <div class="passenger-index-badge">
                  <span>Passenger <%= passenger_form.index + 1 %></span>
                </div>
                <span class="seat-assignment-badge">Seat <%= 12 + passenger_form.index %><%= %w[A B C D E F][passenger_form.index % 6] %> &bull; Economy Class</span>
              </div>

              <div class="passenger-fields-grid">
                <div class="form-group">
                  <%= passenger_form.label :name, "Full Name", class: "form-label" do %>
                    <span>Full Legal Name</span>
                    <span class="required-indicator">*</span>
                  <% end %>
                  <%= passenger_form.text_field :name,
                                               required: true,
                                               placeholder: "e.g., Jane Margaret Doe",
                                               class: "form-input",
                                               id: "booking_passengers_attributes_#{passenger_form.index}_name" %>
                  <small class="field-hint">Must match official passport or photo ID.</small>
                </div>

                <div class="form-group">
                  <%= passenger_form.label :email, "Email Address", class: "form-label" do %>
                    <span>Email Address</span>
                    <span class="required-indicator">*</span>
                  <% end %>
                  <%= passenger_form.email_field :email,
                                                required: true,
                                                placeholder: "e.g., jane.doe@example.com",
                                                class: "form-input",
                                                id: "booking_passengers_attributes_#{passenger_form.index}_email" %>
                  <small class="field-hint">Boarding passes and flight status updates will be sent here.</small>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="checkout-actions-card">
          <div class="checkout-price-breakdown">
            <div class="price-row">
              <span><%= pluralize(@num_tickets, "Airfare Ticket") %></span>
              <span>$<%= (149 + (@flight.duration / 3)) * @num_tickets %></span>
            </div>
            <div class="price-row taxes">
              <span>Taxes & Carrier Surcharges</span>
              <span>Included</span>
            </div>
            <div class="price-row total">
              <span>Total Due:</span>
              <span class="total-figure">$<%= (149 + (@flight.duration / 3)) * @num_tickets %></span>
            </div>
          </div>

          <div class="checkout-submit-group">
            <%= f.submit "Confirm Booking & Issue Tickets →", class: "btn-primary btn-large", id: "submit-booking-btn" %>
            <p class="terms-disclaimer">
              By confirming, you agree to Aero's terms of carriage and Odin Project simulation guidelines.
            </p>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>
