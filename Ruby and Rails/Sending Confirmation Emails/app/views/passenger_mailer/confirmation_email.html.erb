<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Flight Booking Confirmation</title>
    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        background-color: #f1f5f9;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #1e293b;
        -webkit-font-smoothing: antialiased;
      }
      table {
        border-collapse: collapse;
      }
      .email-container {
        max-width: 600px;
        margin: 24px auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .header-bar {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        padding: 28px 32px;
        text-align: center;
        color: #ffffff;
      }
      .brand-title {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: 2px;
        margin: 0 0 6px 0;
        text-transform: uppercase;
      }
      .brand-subtitle {
        font-size: 13px;
        font-weight: 500;
        opacity: 0.9;
        margin: 0;
        letter-spacing: 0.5px;
      }
      .content-body {
        padding: 32px;
      }
      .greeting {
        font-size: 22px;
        font-weight: 700;
        color: #0f172a;
        margin-top: 0;
        margin-bottom: 8px;
      }
      .intro-text {
        font-size: 15px;
        line-height: 1.6;
        color: #475569;
        margin-top: 0;
        margin-bottom: 24px;
      }
      .ref-card {
        background-color: #f8fafc;
        border: 1.5px dashed #0284c7;
        border-radius: 8px;
        padding: 16px 20px;
        text-align: center;
        margin-bottom: 24px;
      }
      .ref-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 4px;
      }
      .ref-code {
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 24px;
        font-weight: 800;
        color: #0284c7;
        letter-spacing: 3px;
      }
      .flight-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 24px;
      }
      .flight-card-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 12px;
        margin-bottom: 16px;
      }
      .flight-badge {
        background-color: #0284c7;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 4px;
        letter-spacing: 1px;
        display: inline-block;
      }
      .flight-date-title {
        font-size: 14px;
        font-weight: 600;
        color: #334155;
        float: right;
      }
      .route-table {
        width: 100%;
      }
      .station-code {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
      }
      .station-city {
        font-size: 13px;
        color: #64748b;
        margin: 2px 0 0 0;
      }
      .station-time {
        font-size: 14px;
        font-weight: 600;
        color: #0284c7;
        margin: 4px 0 0 0;
      }
      .route-middle {
        text-align: center;
        padding: 0 12px;
      }
      .route-duration {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 4px;
      }
      .route-arrow {
        color: #0284c7;
        font-size: 18px;
        font-weight: bold;
      }
      .details-table {
        width: 100%;
        margin-top: 16px;
        border-top: 1px solid #e2e8f0;
        padding-top: 12px;
      }
      .details-label {
        font-size: 11px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
        padding: 6px 0;
      }
      .details-val {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        text-align: right;
        padding: 6px 0;
      }
      .btn-container {
        text-align: center;
        margin: 28px 0;
      }
      .cta-button {
        display: inline-block;
        background-color: #0284c7;
        color: #ffffff !important;
        text-decoration: none;
        font-size: 15px;
        font-weight: 700;
        padding: 14px 28px;
        border-radius: 8px;
        box-shadow: 0 2px 4px rgba(2, 132, 199, 0.25);
      }
      .info-notice {
        background-color: #eff6ff;
        border-left: 4px solid #0284c7;
        padding: 14px 16px;
        border-radius: 0 8px 8px 0;
        margin-bottom: 24px;
        font-size: 13px;
        line-height: 1.5;
        color: #1e40af;
      }
      .footer {
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 20px 32px;
        text-align: center;
        font-size: 12px;
        color: #94a3b8;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <!-- Header -->
      <div class="header-bar">
        <div class="brand-title">✈ AERO AIRLINES</div>
        <div class="brand-subtitle">ELECTRONIC TICKET & BOOKING CONFIRMATION</div>
      </div>

      <!-- Main Body -->
      <div class="content-body">
        <h1 class="greeting">Hello, <%= @passenger.name %>!</h1>
        <p class="intro-text">
          Thank you for choosing Aero Airlines. Your flight booking has been confirmed and your electronic ticket has been issued.
        </p>

        <!-- Booking Reference Box -->
        <div class="ref-card">
          <span class="ref-label">Booking Reference Code</span>
          <span class="ref-code"><%= @booking.booking_reference %></span>
        </div>

        <!-- Flight Card -->
        <div class="flight-card">
          <div class="flight-card-header">
            <span class="flight-badge"><%= @flight.flight_number %></span>
            <span class="flight-date-title"><%= @flight.formatted_full_date %></span>
          </div>

          <table class="route-table">
            <tr>
              <td style="width: 40%; vertical-align: top;">
                <p class="station-code"><%= @departure_airport.code %></p>
                <p class="station-city"><%= @departure_airport.city %></p>
                <p class="station-time"><%= @flight.formatted_time %></p>
              </td>
              <td class="route-middle" style="width: 20%; vertical-align: middle;">
                <div class="route-duration"><%= @flight.formatted_duration %></div>
                <div class="route-arrow">✈ ➔</div>
                <div style="font-size: 10px; color: #94a3b8; margin-top: 2px;">Non-stop</div>
              </td>
              <td style="width: 40%; vertical-align: top; text-align: right;">
                <p class="station-code"><%= @arrival_airport.code %></p>
                <p class="station-city"><%= @arrival_airport.city %></p>
                <p class="station-time"><%= @flight.formatted_arrival_time %></p>
              </td>
            </tr>
          </table>

          <table class="details-table">
            <tr>
              <td class="details-label">Passenger Name:</td>
              <td class="details-val"><%= @passenger.name %></td>
            </tr>
            <tr>
              <td class="details-label">Passenger Email:</td>
              <td class="details-val"><%= @passenger.email %></td>
            </tr>
            <tr>
              <td class="details-label">Departure Airport:</td>
              <td class="details-val"><%= @departure_airport.name %> (<%= @departure_airport.code %>)</td>
            </tr>
            <tr>
              <td class="details-label">Arrival Airport:</td>
              <td class="details-val"><%= @arrival_airport.name %> (<%= @arrival_airport.code %>)</td>
            </tr>
            <tr>
              <td class="details-label">Cabin Class:</td>
              <td class="details-val">Main Cabin</td>
            </tr>
            <tr>
              <td class="details-label">Booking Status:</td>
              <td class="details-val" style="color: #16a34a;">CONFIRMED</td>
            </tr>
            <% if @booking.passengers.count > 1 %>
              <tr>
                <td class="details-label">Traveling Companions:</td>
                <td class="details-val">
                  <%= @booking.passengers.reject { |p| p.id == @passenger.id }.map(&:name).join(", ") %>
                </td>
              </tr>
            <% end %>
          </table>
        </div>

        <!-- Call to Action -->
        <div class="btn-container">
          <a href="<%= @url %>" class="cta-button">View Boarding Pass Online</a>
        </div>

        <!-- Travel Notice -->
        <div class="info-notice">
          <strong>Airport Travel Advisory:</strong> Please arrive at <%= @departure_airport.code %> at least 2 hours prior to scheduled departure for domestic flights. Be prepared with government-issued photo identification and your booking reference <strong><%= @booking.booking_reference %></strong>.
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p style="margin: 0 0 6px 0;">This email was sent to <%= @passenger.email %> for booking <%= @booking.booking_reference %>.</p>
        <p style="margin: 0;">© <%= Time.current.year %> Aero Airlines. The Odin Project Flight Booker.</p>
      </div>
    </div>
  </body>
</html>

