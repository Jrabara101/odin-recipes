<% content_for :title, "Whisper a Secret | Members Only" %>

<div class="container">
  <div class="auth-wrapper" style="max-width: 640px;">
    <div class="form-card">
      <div class="form-header">
        <div class="form-icon">✍️</div>
        <h2>Whisper to the Clubhouse</h2>
        <p>Share a story or secret with the society. Members inside will see your name, while outsiders will only see your words.</p>
      </div>

      <!-- Live author disclosure reminder -->
      <div class="author-disclosure-box">
        <span style="font-size: 1.3rem;">🛡️</span>
        <div>
          Posting as <strong><%= current_user.name %></strong> (<%= current_user.email %>).<br>
          <span style="color: #94a3b8; font-size: 0.8rem;">Your identity remains protected from non-members.</span>
        </div>
      </div>

      <%= form_with(model: @post, local: true, id: "new-secret-post-form") do |f| %>
        <% if @post.errors.any? %>
          <div id="error_explanation">
            <h2><%= pluralize(@post.errors.count, "error") %> prevented this secret from being recorded:</h2>
            <ul>
              <% @post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :title, "Secret Title", class: "form-label" %>
          <%= f.text_field :title, 
                           class: "form-input", 
                           id: "post_title", 
                           placeholder: "e.g., The Midnight Rendezvous in Salon B", 
                           required: true,
                           autofocus: true %>
        </div>

        <div class="form-group">
          <%= f.label :body, "Your Whisper / Story", class: "form-label" %>
          <%= f.text_area :body, 
                          class: "form-textarea", 
                          id: "post_body", 
                          rows: 6, 
                          placeholder: "Write your confidential story, dispatch, or insight here...", 
                          required: true %>
        </div>

        <div class="form-actions">
          <%= f.submit "Publish Secret Whisper", class: "btn btn-primary btn-lg", id: "submit-post-btn" %>
        </div>
      <% end %>

      <div class="auth-footer">
        <%= link_to "← Return to Clubhouse Lounge", root_path %>
      </div>
    </div>
  </div>
</div>
