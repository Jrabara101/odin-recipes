<div class="card post-card" id="post-<%= post.id %>">
  <div class="post-header">
    <div class="post-author-wrap">
      <%= link_to user_path(post.user) do %>
        <%= user_avatar(post.user, size: 40) %>
      <% end %>
      <div>
        <%= link_to post.user.full_name, user_path(post.user), class: "post-author-name" %>
        <div class="post-time"><%= format_time_ago(post.created_at) %></div>
      </div>
    </div>

    <% if post.user == current_user %>
      <%= button_to post_path(post), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this post?" }, class: "post-delete-btn", title: "Delete post" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
        </svg>
      <% end %>
    <% end %>
  </div>

  <% if post.content.present? %>
    <div class="post-content"><%= post.content %></div>
  <% end %>

  <% if post.image.attached? %>
    <div class="post-image-wrap">
      <%= image_tag post.image, class: "post-image", alt: "Post attachment" %>
    </div>
  <% end %>

  <%= render "likes/like_button", post: post %>

  <div class="comments-section">
    <div class="comments-list" id="comments-list-<%= post.id %>">
      <% post.comments.each do |comment| %>
        <%= render "comments/comment", comment: comment %>
      <% end %>
    </div>

    <%= render "comments/form", post: post %>
  </div>
</div>

