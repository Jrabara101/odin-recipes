<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "OdinBook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <header class="top-navbar">
        <div class="nav-container">
          <div class="nav-brand">
            <%= link_to root_path, class: "brand-logo" do %>
              <span class="logo-circle">ob</span>
              <span class="logo-text">OdinBook</span>
            <% end %>
          </div>

          <nav class="nav-center">
            <%= link_to root_path, class: "nav-tab #{'active' if current_page?(root_path)}", title: "Newsfeed" do %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
              <span>Feed</span>
            <% end %>

            <%= link_to users_path, class: "nav-tab #{'active' if current_page?(users_path) && params[:tab].blank?}", title: "Find People" do %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
              </svg>
              <span>Find Friends</span>
            <% end %>

            <%= link_to users_path(tab: "requests"), class: "nav-tab #{'active' if params[:tab] == 'requests'}", title: "Friend Requests" do %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
              <span>Requests</span>
              <% req_count = current_user.pending_friend_requests_received.count %>
              <% if req_count > 0 %>
                <span class="nav-badge"><%= req_count %></span>
              <% end %>
            <% end %>
          </nav>

          <div class="nav-right">
            <%= link_to user_path(current_user), class: "user-pill" do %>
              <%= user_avatar(current_user, size: 32) %>
              <span class="user-pill-name"><%= current_user.first_name.presence || current_user.full_name.split.first %></span>
            <% end %>

            <%= link_to edit_user_path(current_user), class: "icon-btn", title: "Edit Profile" do %>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
              </svg>
            <% end %>

            <%= button_to destroy_user_session_path, method: :delete, class: "icon-btn logout-btn", title: "Log Out" do %>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
              </svg>
            <% end %>
          </div>
        </div>
      </header>
    <% end %>

    <div class="flash-messages">
      <% if notice %>
        <div class="alert alert-notice">
          <span><%= notice %></span>
          <button onclick="this.parentElement.remove();" class="alert-close">&times;</button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger">
          <span><%= alert %></span>
          <button onclick="this.parentElement.remove();" class="alert-close">&times;</button>
        </div>
      <% end %>
    </div>

    <main class="page-body">
      <%= yield %>
    </main>
  </body>
</html>
