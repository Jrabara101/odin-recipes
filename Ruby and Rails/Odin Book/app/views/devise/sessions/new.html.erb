<div class="auth-page">
  <div class="card auth-card">
    <div class="auth-brand">
      <div class="logo-circle" style="width: 54px; height: 54px; font-size: 26px; margin: 0 auto 12px;">ob</div>
      <h1 class="logo-text" style="font-size: 32px;">OdinBook</h1>
      <p style="color: var(--text-secondary); font-size: 14px; margin-top: 4px;">Connect with friends and the world around you.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Email address" %>
      </div>

      <div class="form-group">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, style: "font-size: 13px; color: var(--text-secondary); margin-bottom: 0;" %>
        </div>
      <% end %>

      <div style="margin-top: 20px;">
        <%= f.submit "Log In", class: "btn btn-primary", style: "width: 100%; padding: 12px; font-size: 16px;" %>
      </div>
    <% end %>

    <div class="auth-divider">or</div>

    <div>
      <%= link_to "Create new account", new_registration_path(resource_name), class: "btn btn-success", style: "width: 100%; padding: 12px; font-size: 15px;" %>
    </div>

    <div class="auth-links">
      <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
        <%= link_to "Forgot your password?", new_password_path(resource_name), style: "font-size: 13px; color: var(--text-secondary);" %>
      <% end %>
    </div>

    <div style="margin-top: 20px; background: #f0f2f5; padding: 12px; border-radius: var(--radius-sm); font-size: 12px; text-align: left; color: var(--text-secondary);">
      <strong>Demo Accounts (after db:seed):</strong><br/>
      Email: <code>alice@example.com</code> / Password: <code>password123</code><br/>
      Email: <code>bob@example.com</code> / Password: <code>password123</code>
    </div>
  </div>
</div>
