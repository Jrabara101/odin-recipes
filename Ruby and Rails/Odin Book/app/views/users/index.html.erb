<div style="max-width: 1000px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2>People & Connections</h2>
  </div>

  <nav class="tabs-nav">
    <%= link_to "All Users", users_path, class: "tab-link #{'active' if @tab == 'all'}" %>
    <%= link_to "My Friends (#{current_user.friends.count})", users_path(tab: "friends"), class: "tab-link #{'active' if @tab == 'friends'}" %>
    <%= link_to "Requests (#{current_user.pending_friend_requests_received.count})", users_path(tab: "requests"), class: "tab-link #{'active' if @tab == 'requests'}" %>
  </nav>

  <% if @tab == "requests" %>
    <div style="margin-bottom: 24px;">
      <h3 style="margin-bottom: 12px; font-size: 18px;">Received Requests (<%= @received_requests.count %>)</h3>
      <% if @received_requests.any? %>
        <div class="users-grid">
          <% @received_requests.each do |req| %>
            <%= render "users/user_card", user: req.sender %>
          <% end %>
        </div>
      <% else %>
        <div class="card empty-state" style="padding: 24px;">
          <p>No incoming friend requests right now.</p>
        </div>
      <% end %>
    </div>

    <div>
      <h3 style="margin-bottom: 12px; font-size: 18px;">Sent Requests (<%= @sent_requests.count %>)</h3>
      <% if @sent_requests.any? %>
        <div class="users-grid">
          <% @sent_requests.each do |req| %>
            <%= render "users/user_card", user: req.receiver %>
          <% end %>
        </div>
      <% else %>
        <div class="card empty-state" style="padding: 24px;">
          <p>You have no pending outgoing friend requests.</p>
        </div>
      <% end %>
    </div>

  <% else %>
    <% if @users.any? %>
      <div class="users-grid">
        <% @users.each do |user| %>
          <%= render "users/user_card", user: user %>
        <% end %>
      </div>
    <% else %>
      <div class="card empty-state">
        <div class="empty-state-icon">&#128101;</div>
        <h3 class="empty-state-title">No users found</h3>
        <p class="empty-state-desc"><%= @tab == "friends" ? "You haven't added any friends yet. Explore All Users to connect!" : "No other users registered yet." %></p>
        <% if @tab == "friends" %>
          <%= link_to "Browse Users", users_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

