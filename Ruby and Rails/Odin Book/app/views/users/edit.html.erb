<div style="max-width: 600px; margin: 0 auto;">
  <div class="card" style="padding: 28px;">
    <h2 style="font-size: 22px; font-weight: 800; margin-bottom: 20px;">Edit Profile</h2>

    <%= form_with(model: @user, local: true) do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <!-- Avatar preview & file upload -->
      <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border);">
        <%= user_avatar(@user, size: 80) %>
        <div>
          <label class="form-label">Profile Photo</label>
          <%= f.file_field :avatar, accept: "image/*", class: "form-control", style: "padding: 6px;" %>
          <div style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;">
            Upload a custom photo or your Gravatar will be used automatically.
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :first_name, class: "form-label" %>
          <%= f.text_field :first_name, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :last_name, class: "form-label" %>
          <%= f.text_field :last_name, class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :username, class: "form-label" %>
        <%= f.text_field :username, class: "form-control", placeholder: "e.g. johndoe" %>
      </div>

      <div class="form-group">
        <%= f.label :bio, class: "form-label" %>
        <%= f.text_area :bio, rows: 4, class: "form-control", placeholder: "Tell people a little bit about yourself..." %>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
        <%= link_to "Cancel", user_path(@user), class: "btn btn-secondary" %>
        <%= f.submit "Save Changes", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

