<div class="form-card">
  <%= form_with(model: event) do |f| %>
    <% if event.errors.any? %>
      <div class="flash-message flash-alert" style="margin-bottom: 1.5rem;">
        <div>
          <strong><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</strong>
          <ul style="margin-top: 0.5rem; padding-left: 1.25rem;">
            <% event.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title, "Event Title", class: "form-label" %>
      <%= f.text_field :title, class: "form-control", placeholder: "e.g. Andy's Rooftop BBQ & Board Games", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :date, "Event Date & Time", class: "form-label" %>
      <%= f.datetime_local_field :date, class: "form-control", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :location, "Location / Venue", class: "form-label" %>
      <%= f.text_field :location, class: "form-control", placeholder: "e.g. 124 Elm Street or Andy's House", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :description, "Description & Details", class: "form-label" %>
      <%= f.text_area :description, class: "form-control", placeholder: "Describe the vibe, what to bring, food/drink plans, etc...", required: true %>
    </div>

    <div class="form-group" style="padding: 1rem; background: var(--bg-surface-elevated); border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
      <label class="form-checkbox-label">
        <%= f.check_box :private, style: "width: 1.15rem; height: 1.15rem; accent-color: #6366f1;" %>
        <div>
          <strong style="color: var(--text-main);">Private Event</strong>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.15rem;">
            Only people specifically invited by you will be able to view and RSVP to this event.
          </p>
        </div>
      </label>
    </div>

    <div class="form-actions">
      <%= f.submit (event.persisted? ? "Update Event" : "Create Event"), class: "btn btn-primary" %>
      <%= link_to "Cancel", (event.persisted? ? event_path(event) : events_path), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
