<div style="margin-bottom: 1.5rem;">
  <%= link_to "&larr; Back to All Events".html_safe, events_path, class: "btn btn-outline btn-sm" %>
</div>

<!-- Event Hero Header -->
<div class="event-detail-header">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <% if @event.past? %>
        <span class="badge-privacy badge-past">Past Event</span>
      <% elsif @event.private? %>
        <span class="badge-privacy badge-private">Private Event</span>
      <% else %>
        <span class="badge-privacy badge-public">Public Event</span>
      <% end %>

      <span class="section-badge">
        <%= pluralize(@attendees.count, "attendee") %>
      </span>
    </div>

    <!-- Creator Controls -->
    <% if current_user == @event.creator %>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <%= button_to (@event.private? ? "Make Public" : "Make Private"), 
                      toggle_privacy_event_path(@event), 
                      method: :patch, 
                      class: "btn btn-secondary btn-sm" %>
        <%= link_to "Edit Event", edit_event_path(@event), class: "btn btn-secondary btn-sm" %>
        <%= button_to "Delete Event", event_path(@event), 
                      method: :delete, 
                      data: { turbo_confirm: "Are you sure you want to permanently delete this event?" }, 
                      class: "btn btn-danger btn-sm" %>
      </div>
    <% end %>
  </div>

  <h1 class="event-show-title"><%= @event.title %></h1>

  <div style="display: flex; flex-wrap: wrap; gap: 1.75rem; color: var(--text-muted); font-size: 0.95rem; margin-top: 1rem;">
    <div class="meta-item">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <strong><%= @event.date.strftime("%A, %B %d, %Y at %I:%M %p") %></strong>
    </div>

    <div class="meta-item">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <strong><%= @event.location %></strong>
    </div>

    <div class="meta-item">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>Hosted by <%= link_to @event.creator.name.presence || @event.creator.username, user_path(@event.creator), style: "font-weight: 600; text-decoration: underline;" %></span>
    </div>
  </div>
</div>

<!-- Main Details & Sidebar Grid -->
<div class="event-detail-grid">
  <!-- Left Main Column -->
  <div class="event-main-col">
    <!-- Description Card -->
    <div class="detail-card">
      <h2 class="detail-card-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>About This Event</span>
      </h2>
      <div style="font-size: 1rem; line-height: 1.7; color: var(--text-main); white-space: pre-wrap;">
        <%= @event.description %>
      </div>
    </div>

    <!-- RSVP / Attendance Action Card -->
    <div class="detail-card" style="border-left: 4px solid var(--primary);">
      <h2 class="detail-card-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <polyline points="16 11 18 13 22 9"></polyline>
        </svg>
        <span>RSVP & Participation</span>
      </h2>

      <% if user_signed_in? %>
        <% if @event.past? %>
          <p style="color: var(--text-muted);">
            This event has already taken place on <%= @event.date.strftime("%B %d, %Y") %>. RSVPs are closed.
          </p>
        <% elsif current_user.attending?(@event) %>
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div>
              <p style="font-weight: 600; color: #10b981; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                You are registered as attending!
              </p>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                See you there at <%= @event.location %> on <%= @event.date.strftime("%b %d") %>.
              </p>
            </div>
            <%= button_to "Cancel Attendance", 
                          event_event_attendance_path(@event, current_user), 
                          method: :delete, 
                          data: { turbo_confirm: "Are you sure you want to remove yourself from the attendee list?" }, 
                          class: "btn btn-outline btn-sm" %>
          </div>
        <% elsif @attendance&.status == "invited" %>
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div>
              <p style="font-weight: 600; color: #f59e0b;">
                You were personally invited to this private event!
              </p>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                Accept the invitation to confirm your spot.
              </p>
            </div>
            <%= button_to "Accept & RSVP", 
                          event_event_attendances_path(@event), 
                          method: :post, 
                          class: "btn btn-success btn-sm" %>
          </div>
        <% else %>
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div>
              <p style="font-weight: 600; color: var(--text-main);">
                Would you like to attend?
              </p>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                Reserve your spot now and let the host know you're coming.
              </p>
            </div>
            <%= button_to "RSVP / Attend Event", 
                          event_event_attendances_path(@event), 
                          method: :post, 
                          class: "btn btn-primary" %>
          </div>
        <% end %>
      <% else %>
        <p style="color: var(--text-muted); margin-bottom: 1rem;">
          Please sign in or create an account to RSVP for this event.
        </p>
        <div style="display: flex; gap: 0.75rem;">
          <%= link_to "Sign In", new_user_session_path, class: "btn btn-primary btn-sm" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-secondary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Right Sidebar Column -->
  <div class="event-sidebar-col">
    <!-- Host Information Card -->
    <div class="detail-card">
      <h2 class="detail-card-title">
        <span>Event Host</span>
      </h2>
      <div class="creator-info">
        <div class="avatar-circle">
          <%= (@event.creator.name.presence || @event.creator.username).first.upcase %>
        </div>
        <div>
          <div style="font-weight: 700; color: var(--text-main);">
            <%= link_to @event.creator.name.presence || @event.creator.username, user_path(@event.creator) %>
          </div>
          <div style="font-size: 0.85rem; color: var(--text-muted);">
            @<%= @event.creator.username %>
          </div>
          <div style="font-size: 0.8rem; color: var(--text-dim); margin-top: 0.25rem;">
            <%= pluralize(@event.creator.created_events.count, "event") %> hosted
          </div>
        </div>
      </div>
    </div>

    <!-- Attendees List Card -->
    <div class="detail-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 class="detail-card-title" style="margin-bottom: 0;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <span>Attendees</span>
        </h2>
        <span class="section-badge"><%= @attendees.count %></span>
      </div>

      <% if @attendees.any? %>
        <ul class="attendees-list">
          <% @attendees.each do |attendee| %>
            <li class="attendee-item">
              <div class="attendee-profile">
                <div class="avatar-circle avatar-sm">
                  <%= (attendee.name.presence || attendee.username).first.upcase %>
                </div>
                <div>
                  <div style="font-weight: 600; font-size: 0.9rem;">
                    <%= link_to attendee.name.presence || attendee.username, user_path(attendee) %>
                    <% if attendee == @event.creator %>
                      <span style="font-size: 0.7rem; background: rgba(99, 102, 241, 0.2); color: #a5b4fc; padding: 0.1rem 0.4rem; border-radius: var(--radius-full); margin-left: 0.3rem;">Host</span>
                    <% end %>
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">
                    @<%= attendee.username %>
                  </div>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p style="color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 1rem 0;">
          No attendees registered yet.
        </p>
      <% end %>
    </div>

    <!-- Creator Invitation Card -->
    <% if current_user == @event.creator %>
      <div class="detail-card" style="border: 1px dashed rgba(99, 102, 241, 0.4);">
        <h2 class="detail-card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>Invite Members</span>
        </h2>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
          Invite registered users from the community to join this gathering.
        </p>

        <% if @potential_invitees.present? && @potential_invitees.any? %>
          <%= form_with url: invite_event_path(@event), method: :post do |f| %>
            <div class="form-group" style="margin-bottom: 0.75rem;">
              <%= f.label :user_id, "Select Community Member", class: "form-label", style: "font-size: 0.8rem;" %>
              <%= f.collection_select :user_id, 
                                      @potential_invitees, 
                                      :id, 
                                      ->(u) { "#{u.name} (@#{u.username})" }, 
                                      { prompt: "Choose a user to invite..." }, 
                                      { class: "form-control", style: "font-size: 0.85rem; padding: 0.5rem 0.75rem;", required: true } %>
            </div>
            <%= f.submit "Send Invitation", class: "btn btn-primary btn-sm", style: "width: 100%;" %>
          <% end %>
        <% else %>
          <p style="font-size: 0.85rem; color: var(--text-dim); text-align: center; padding: 0.5rem 0;">
            All registered members are already attending or invited!
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
