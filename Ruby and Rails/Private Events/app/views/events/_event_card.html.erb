<div class="event-card">
  <div class="card-top">
    <% if event.past? %>
      <span class="badge-privacy badge-past">Past Event</span>
    <% elsif event.private? %>
      <span class="badge-privacy badge-private">Private</span>
    <% else %>
      <span class="badge-privacy badge-public">Public</span>
    <% end %>

    <span class="attendee-count">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <%= pluralize(event.attendees.count, "attendee") %>
    </span>
  </div>

  <h3 class="event-card-title">
    <%= link_to event.title, event_path(event) %>
  </h3>

  <div class="event-meta">
    <div class="meta-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span><%= event.date.strftime("%B %d, %Y • %I:%M %p") %></span>
    </div>

    <div class="meta-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span><%= event.location %></span>
    </div>

    <div class="meta-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span>Hosted by <%= link_to event.creator.name.presence || event.creator.username, user_path(event.creator) %></span>
    </div>
  </div>

  <p class="event-description"><%= event.description %></p>

  <div class="card-footer">
    <%= link_to "View Event Details &rarr;".html_safe, event_path(event), class: "btn btn-secondary btn-sm" %>

    <% if user_signed_in? && !event.past? %>
      <% if current_user.attending?(event) %>
        <span style="font-size: 0.85rem; color: #10b981; font-weight: 600; display: flex; align-items: center; gap: 0.25rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Attending
        </span>
      <% else %>
        <%= button_to "RSVP Now", event_event_attendances_path(event), method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
    <% end %>
  </div>
</div>
