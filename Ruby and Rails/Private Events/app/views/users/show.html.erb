<!-- User Profile Banner -->
<div class="profile-banner">
  <div class="profile-identity">
    <div class="profile-avatar">
      <%= (@user.name.presence || @user.username).first.upcase %>
    </div>
    <div>
      <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 800; line-height: 1.2;">
        <%= @user.name.presence || @user.username %>
      </h1>
      <p style="color: #818cf8; font-weight: 600; margin-top: 0.2rem;">
        @<%= @user.username %>
      </p>
      <p style="font-size: 0.85rem; color: var(--text-dim); margin-top: 0.35rem;">
        Member since <%= @user.created_at.strftime("%B %Y") %>
      </p>
    </div>
  </div>

  <div class="profile-stats">
    <div class="stat-box">
      <div class="stat-value"><%= @user.created_events.count %></div>
      <div class="stat-label">Events Hosted</div>
    </div>
    <div class="stat-box">
      <div class="stat-value"><%= @user.attended_events.count %></div>
      <div class="stat-label">Events Attended</div>
    </div>
  </div>
</div>

<!-- Section 1: Created Events -->
<section style="margin-bottom: 3.5rem;">
  <div class="section-header">
    <h2 class="section-title">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: #6366f1;">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
      </svg>
      <span>Events Created by <%= @user.name.presence || @user.username %></span>
      <span class="section-badge"><%= @user.created_events.count %></span>
    </h2>
    <% if current_user == @user %>
      <%= link_to "+ Create New Event", new_event_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <% if @user.created_events.any? %>
    <div class="events-grid">
      <% @user.created_events.order(date: :desc).each do |event| %>
        <%= render "events/event_card", event: event %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">🎪</div>
      <h3>No Created Events Yet</h3>
      <p><%= @user.name.presence || @user.username %> hasn't hosted any events yet.</p>
      <% if current_user == @user %>
        <div style="margin-top: 1.25rem;">
          <%= link_to "Host Your First Event", new_event_path, class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<!-- Section 2: Attended Events Query Logic (Handled in the View per TOP specifications) -->
<% upcoming_attended = @user.attended_events.where("date >= ?", Time.current).order(date: :asc) %>
<% past_attended = @user.attended_events.where("date < ?", Time.current).order(date: :desc) %>

<!-- Upcoming Attended Events -->
<section style="margin-bottom: 3.5rem;">
  <div class="section-header">
    <h2 class="section-title">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: #10b981;">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 14 14"></polyline>
      </svg>
      <span>Upcoming Attended Events</span>
      <span class="section-badge"><%= upcoming_attended.count %></span>
    </h2>
  </div>

  <% if upcoming_attended.any? %>
    <div class="events-grid">
      <% upcoming_attended.each do |event| %>
        <%= render "events/event_card", event: event %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">🎟️</div>
      <h3>No Upcoming Events</h3>
      <p><%= @user.name.presence || @user.username %> is not currently registered for any upcoming events.</p>
    </div>
  <% end %>
</section>

<!-- Past Attended Events -->
<section>
  <div class="section-header">
    <h2 class="section-title">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: #9ca3af;">
        <path d="M3 3v5h5"></path>
        <path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"></path>
        <path d="M12 7v5l4 2"></path>
      </svg>
      <span>Past Attended Events</span>
      <span class="section-badge"><%= past_attended.count %></span>
    </h2>
  </div>

  <% if past_attended.any? %>
    <div class="events-grid">
      <% past_attended.each do |event| %>
        <%= render "events/event_card", event: event %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">📜</div>
      <h3>No Past Event History</h3>
      <p><%= @user.name.presence || @user.username %> hasn't attended any events that have finished yet.</p>
    </div>
  <% end %>
</section>
