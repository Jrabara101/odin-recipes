<div class="form-card" style="max-width: 480px;">
  <div style="text-align: center; margin-bottom: 2rem;">
    <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">
      Welcome Back
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
      Sign in to manage your events and check invitations
    </p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-group">
      <%= f.label :email, "Email Address", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "you@example.com", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Password", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;".html_safe, required: true %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-group">
        <label class="form-checkbox-label">
          <%= f.check_box :remember_me, style: "accent-color: #6366f1;" %>
          <span style="color: var(--text-muted); font-size: 0.9rem;">Remember me on this device</span>
        </label>
      </div>
    <% end %>

    <div class="form-group" style="margin-top: 2rem;">
      <%= f.submit "Sign In", class: "btn btn-primary", style: "width: 100%;" %>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-dim);">
    <%= render "devise/shared/links" %>
  </div>
</div>
