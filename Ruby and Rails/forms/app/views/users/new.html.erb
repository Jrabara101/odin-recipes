<div class="page-container">
  <header class="app-header">
    <div class="badge">The Odin Project</div>
    <h1>Re-Former: New User</h1>
    <p class="subtitle">Bare-metal HTML forms transitioning to modern Rails <code>form_with</code> helpers.</p>
  </header>

  <% if flash[:notice] %>
    <div class="flash-notice">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if @user.errors.any? %>
    <div id="error_explanation" class="error-container">
      <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- ================================================================= -->
  <!-- ACTIVE: Railsy Form using #form_with helper                       -->
  <!-- ================================================================= -->
  <div class="card form-card">
    <div class="card-header">
      <h2>Create User with <code>form_with</code></h2>
      <span class="tag">Rails Helper Mode</span>
    </div>

    <%= form_with model: @user, class: "user-form" do |form| %>
      <div class="form-group">
        <%= form.label :username, "Your user name here" %>
        <%= form.text_field :username, placeholder: "e.g. odin_coder", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= form.label :email, "Email Address" %>
        <%= form.email_field :email, placeholder: "example@example.com", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= form.label :password, "Password" %>
        <%= form.password_field :password, placeholder: "Minimum 6 characters", class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Create User", class: "btn btn-primary" %>
        <%= link_to "View All Users", users_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>

  <!-- ================================================================= -->
  <!-- ODIN PROJECT CURRICULUM ARCHIVE: BARE-METAL HTML FORMS (STEPS 1-3) -->
  <!-- ================================================================= -->
  <!--
  === STAGE 1: Bare Metal HTML form with flat params and data-turbo="false" ===
  <form action="/users" method="post" accept-charset="UTF-8" data-turbo="false">
    <label for="flat_username">Username:</label>
    <input type="text" id="flat_username" name="username">

    <label for="flat_email">Email:</label>
    <input type="email" id="flat_email" name="email">

    <label for="flat_password">Password:</label>
    <input type="password" id="flat_password" name="password">

    <input type="submit" value="Submit Form (Flat Params)">
  </form>

  === STAGE 2: Adding manual CSRF authenticity token to bare HTML form ===
  <form action="/users" method="post" accept-charset="UTF-8" data-turbo="false">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <label for="csrf_username">Username:</label>
    <input type="text" id="csrf_username" name="username">

    <label for="csrf_email">Email:</label>
    <input type="email" id="csrf_email" name="email">

    <label for="csrf_password">Password:</label>
    <input type="password" id="csrf_password" name="password">

    <input type="submit" value="Submit with Authenticity Token">
  </form>

  === STAGE 3: Nested attributes (user[...]) for strong parameters support ===
  <form action="/users" method="post" accept-charset="UTF-8" data-turbo="false">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <div>
      <label for="nested_username">Username:</label>
      <input type="text" id="nested_username" name="user[username]" value="<%= @user&.username %>">
    </div>

    <div>
      <label for="nested_email">Email:</label>
      <input type="email" id="nested_email" name="user[email]" value="<%= @user&.email %>">
    </div>

    <div>
      <label for="nested_password">Password:</label>
      <input type="password" id="nested_password" name="user[password]">
    </div>

    <input type="submit" value="Create User (Nested HTML Form)">
  </form>
  -->
</div>
