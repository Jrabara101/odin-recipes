<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "AERO // Odin Flight Booker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="One-way flight booker built for The Odin Project with Ruby on Rails 7. Search flights, choose your departure, and book tickets with nested passenger attributes.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Top Navigation -->
    <header class="site-header">
      <div class="nav-container">
        <a href="/" class="brand-logo" id="nav-brand-logo">
          <div class="brand-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-name">AERO</span>
            <span class="brand-tag">FLIGHT BOOKER</span>
          </div>
        </a>

        <nav class="nav-links">
          <a href="/" class="nav-link <%= 'active' if controller_name == 'flights' %>" id="nav-search-flights">Search Flights</a>
          <a href="https://www.theodinproject.com/lessons/ruby-on-rails-flight-booker" target="_blank" rel="noopener noreferrer" class="nav-link external-link" id="nav-odin-project">
            <span>Odin Project Specs</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Container -->
    <main class="main-content">
      <% if flash[:notice].present? %>
        <div class="flash-banner notice" id="flash-notice">
          <div class="flash-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="flash-text"><%= flash[:notice] %></div>
        </div>
      <% end %>

      <% if flash[:alert].present? %>
        <div class="flash-banner alert" id="flash-alert">
          <div class="flash-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <div class="flash-text"><%= flash[:alert] %></div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-container">
        <p class="footer-credits">
          Built with <strong>Ruby on Rails 7</strong> for <a href="https://www.theodinproject.com" target="_blank" rel="noopener">The Odin Project</a>.
        </p>
        <p class="footer-meta">
          Features Advanced Forms &bull; Collection Dropdowns &bull; Radio Selection &bull; Nested Passenger Attributes (<code class="inline-code">accepts_nested_attributes_for</code>)
        </p>
      </div>
    </footer>
  </body>
</html>
